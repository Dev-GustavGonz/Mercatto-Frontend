# Variables para el despliegue (configúralas en el panel de Vercel/Netlify, no subas el .env real)

# URL PÚBLICA y HTTPS del backend (ej. el túnel de cloudflared/ngrok o el servidor real).
# Debe terminar en /api
VITE_API_URL=https://TU-BACKEND-PUBLICO.example.com/api

VITE_GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Opcional: si no hay n8n público, el chatbot usa respuestas de respaldo
VITE_N8N_WEBHOOK_URL=
